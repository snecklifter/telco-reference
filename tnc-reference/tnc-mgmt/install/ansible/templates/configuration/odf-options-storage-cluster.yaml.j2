---
- op: replace
  path: /spec/storageDeviceSets/0/count
  value: {{ configuration.odf.disk_paths | length }}

- op: replace
  path: /spec/storageDeviceSets/0/dataPVCTemplate/spec/resources/requests/storage
  value: "{{ configuration.odf.storage_size }}"

- op: replace
  path: /spec/storageDeviceSets/0/dataPVCTemplate/spec/storageClassName
  value: "{{ configuration.odf.storage_class }}"
{% if configuration.odf.encryption | default(false) %}

- op: add
  path: /spec/encryption
  value:
    clusterWide: true
    kms:
      enable: true
{% endif %}
