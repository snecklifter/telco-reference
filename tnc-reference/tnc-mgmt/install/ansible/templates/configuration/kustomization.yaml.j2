---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
{% if 'talm' in configuration.components %}
  - reference-crs/required/talm/
{% endif %}
{% if 'lso' in configuration.components %}
  - overlays/lso/
{% endif %}
{% if 'odf' in configuration.components %}
  - overlays/odf/
{% endif %}
{% if 'gitops' in configuration.components %}
  - overlays/gitops/
{% endif %}
{% if 'acm' in configuration.components %}
  - overlays/acm/
{% endif %}
{% if 'acm' in configuration.components and 'gitops' in configuration.components %}
  # Registers the ACM managed clusters with ArgoCD. Needs both components: the
  # CRDs come from ACM, the target namespace from GitOps.
  - other-crs/required/acm-gitops/
{% endif %}
{% if 'registry' in configuration.components %}
  - overlays/registry/
{% endif %}
{% if 'vault' in configuration.components %}
  - overlays/vault/
{% endif %}
{% if 'quay' in configuration.components %}
  - overlays/quay/
{% endif %}
{% if 'kafka' in configuration.components %}
  - overlays/kafka/
{% endif %}
{% if 'logging' in configuration.components %}
  - overlays/logging
{% endif %}
{% if 'loki' in configuration.components %}
  # Log store for the logging overlay's ClusterLogForwarder. Without it the
  # forwarder has no destination, so enable both or neither.
  - overlays/loki/
{% endif %}
{% if 'monitoring-kafka' in configuration.components %}
  - overlays/monitoring-kafka
{% endif %}
{% if 'gitops-ztp' in configuration.components %}
  - overlays/gitops-ztp/
{% endif %}
{% if 'ansible' in configuration.components %}
  - other-crs/optional/ansible/
{% endif %}
{% if 'cnv' in configuration.components %}
  - other-crs/optional/cnv/
{% endif %}
{% if 'keycloak' in configuration.components %}
  # NetworkPolicies only. Keycloak itself is still deployed by the keycloak
  # role, but the policies are static manifests so ArgoCD can hold them.
  - other-crs/optional/keycloak/
{% endif %}
{% if 'hub-add-ons' in configuration.components %}
  # Creates the hub-add-ons Application, which in turn syncs
  # configuration/add-ons. Only the parent is rendered here -- the children
  # are not in this kustomization, so nothing manages them twice.
  - other-crs/optional/hub-add-ons/
{% endif %}

# The reference CRs target a disconnected mirror, so every Subscription ships
# with source: redhat-operators-disconnected. Retarget them here rather than
# rewriting the files in the staging area: most of them live in the
# telco-reference submodule, which ArgoCD pulls straight from the GitLab
# mirror, so a staging-area edit would apply locally and then be reverted by
# the next ArgoCD sync.
patches:
  - target:
      kind: Subscription
    patch: |-
      - op: replace
        path: /spec/source
        value: {{ configuration.catalog_source }}
{% if 'acm' in configuration.components %}

  # MultiClusterHub carries the catalog source inside JSON annotations, which
  # the Subscription patch above does not reach.
  - target:
      kind: MultiClusterHub
    patch: |-
      - op: replace
        path: /metadata/annotations/installer.open-cluster-management.io~1mce-subscription-spec
        value: '{"source": "{{ configuration.catalog_source }}", "installPlanApproval": "Automatic"}'
      - op: replace
        path: /metadata/annotations/installer.open-cluster-management.io~1oadp-subscription-spec
        value: '{"source": "{{ configuration.catalog_source }}", "installPlanApproval": "Automatic"}'
{% endif %}
