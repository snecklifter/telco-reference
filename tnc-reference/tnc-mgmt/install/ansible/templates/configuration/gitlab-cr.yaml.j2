---
apiVersion: apps.gitlab.com/v1beta1
kind: GitLab
metadata:
  name: gitlab
  namespace: gitlab-system
spec:
  chart:
    version: "{{ gitlab_chart_version | default(configuration.gitlab.chart_version) }}"
    values:
      certmanager:
        install: false
      gitlab:
        toolbox:
          backups:
            cron:
              enabled: true
              schedule: "{{ configuration.gitlab.backup_schedule }}"
              extraArgs: "--skip artifacts"
            objectStorage:
              config:
                secret: gitlab-backup-object-storage
                key: connection
      gitlab-exporter:
        enabled: false
      global:
        appConfig:
          artifacts:
            enabled: true
            bucket: gitlab-artifacts-storage
          backups:
            enabled: true
            bucket: gitlab-backup-storage
            tmpBucket: gitlab-tmp-storage
          dependencyProxy:
            enabled: true
            bucket: gitlab-dependency-proxy
          lfs:
            bucket: gitlab-lfs-storage
          object_store:
            enabled: true
            connection:
              secret: gitlab-object-storage
              key: connection
{% if configuration.gitlab.keycloak_enabled | default(false) %}
          omniauth:
            enabled: true
            allowSingleSignOn:
              - openid_connect
            autoLinkLdapUser: false
            blockAutoCreatedUsers: true
            providers:
              - key: provider
                secret: gitlab-keycloak
{% endif %}
          packages:
            enabled: true
            bucket: gitlab-packages-storage
          terraformState:
            enabled: true
            bucket: gitlab-terraform-state
          uploads:
            enabled: true
            bucket: gitlab-uploads-storage
        gatewayApi:
          enabled: false
        hosts:
          # The routes terminate TLS at the edge, so users reach GitLab over
          # https while ingress.tls.enabled below is false -- that flag is
          # about the chart managing its own Ingress and certificates, which
          # it does not here. Without this, hosts.https defaults to that flag
          # and GitLab builds every external URL as http://, including the
          # OAuth redirect the Web IDE uses. The page is https, so the
          # redirect is blocked as mixed content and the Web IDE fails with
          # "Failed to load the Web IDE" while the rest of GitLab is fine.
          https: true
          domain: apps.{{ cluster.name }}.{{ cluster.base_domain }}
          pages:
            name: {{ configuration.gitlab.pages_subdomain }}.apps.{{ cluster.name }}.{{ cluster.base_domain }}
        ingress:
          # Tells the chart the deployment is edge-terminated. The routes do
          # the terminating; this is how the chart learns that, since it
          # creates no Ingress of its own.
          annotations:
            route.openshift.io/termination: edge
          class: none
          configureCertmanager: false
          # No tls block on purpose. Setting tls.enabled false here does not
          # just pick a URL scheme -- it tells the chart the deployment is
          # not TLS terminated anywhere, and webservice and workhorse are
          # configured accordingly. The routes terminate at the edge, so
          # that is wrong, and the Web IDE is what notices: it fails to
          # complete its OAuth exchange while ordinary pages are unaffected.
          # Omitted, it defaults to true, which is what a working instance
          # of this deployment runs with.
        minio:
          enabled: false
        pages:
          enabled: true
          accessControl: true
          host: {{ configuration.gitlab.pages_subdomain }}.apps.{{ cluster.name }}.{{ cluster.base_domain }}
          namespaceInPath: true
          objectStore:
            enabled: true
            bucket: gitlab-pages-storage
            connection:
              secret: gitlab-object-storage
              key: connection
        psql:
          host: {{ configuration.gitlab.psql.host }}
          port: {{ configuration.gitlab.psql.port }}
          database: {{ configuration.gitlab.psql.database }}
          username: {{ configuration.gitlab.psql.username }}
          password:
            secret: {{ configuration.gitlab.psql.secret }}
            key: {{ configuration.gitlab.psql.secret_key }}
        redis:
          host: {{ configuration.gitlab.redis.host }}
          auth:
            secret: {{ configuration.gitlab.redis.secret }}
            key: {{ configuration.gitlab.redis.secret_key }}
        registry:
          enabled: {{ configuration.gitlab.registry_enabled | lower }}
        replicaCount: {{ configuration.gitlab.replicas }}
      metrics:
        enabled: false
      registry:
        storage:
          secret: gitlab-registry-storage
          key: config
      nginx-ingress:
        enabled: false
      postgresql:
        install: false
      prometheus:
        install: false
