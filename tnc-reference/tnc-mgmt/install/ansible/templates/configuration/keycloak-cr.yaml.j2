---
apiVersion: k8s.keycloak.org/v2alpha1
kind: Keycloak
metadata:
  name: keycloak
  namespace: keycloak
spec:
  instances: {{ configuration.keycloak.replicas | default(2) }}
  db:
    vendor: postgres
    host: keycloak-postgres-rw
    database: keycloak
    port: 5432
    usernameSecret:
      name: keycloak-postgres-creds
      key: username
    passwordSecret:
      name: keycloak-postgres-creds
      key: password
  hostname:
    hostname: keycloak.apps.{{ cluster.name }}.{{ cluster.base_domain }}
  http:
    httpEnabled: true
  proxy:
    headers: xforwarded
  unsupported:
    podTemplate:
      spec:
        containers:
          - resources:
              limits:
                cpu: "1"
                memory: "2Gi"
              requests:
                cpu: "500m"
                memory: "1Gi"
