---
apiVersion: k8s.keycloak.org/v2alpha1
kind: KeycloakRealmImport
metadata:
  name: {{ configuration.keycloak.realm }}-realm
  namespace: keycloak
spec:
  keycloakCRName: keycloak
  realm:
    realm: {{ configuration.keycloak.realm }}
    enabled: true
    displayName: OpenShift Platform
    sslRequired: external
    registrationAllowed: false
    loginWithEmailAllowed: true
    duplicateEmailsAllowed: false
    resetPasswordAllowed: true
    editUsernameAllowed: false
    bruteForceProtected: true
    clients:
      - clientId: openshift
        name: OpenShift
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_openshift_client_secret }}
        redirectUris:
          - "https://oauth-openshift.apps.{{ cluster.name }}.{{ cluster.base_domain }}/oauth2callback/keycloak"
        webOrigins:
          - "https://console-openshift-console.apps.{{ cluster.name }}.{{ cluster.base_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
      - clientId: gitlab
        name: GitLab
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_gitlab_client_secret }}
        redirectUris:
          - "https://gitlab.apps.{{ cluster.name }}.{{ cluster.base_domain }}/users/auth/openid_connect/callback"
        webOrigins:
          - "https://gitlab.apps.{{ cluster.name }}.{{ cluster.base_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
      - clientId: netbox
        name: NetBox
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_netbox_client_secret }}
        redirectUris:
          - "https://netbox.apps.{{ cluster.name }}.{{ cluster.base_domain }}/oauth/complete/keycloak/"
        webOrigins:
          - "https://netbox.apps.{{ cluster.name }}.{{ cluster.base_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
