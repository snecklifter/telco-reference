---
apiVersion: k8s.keycloak.org/v2alpha1
kind: KeycloakRealmImport
metadata:
  name: {{ configuration.keycloak.realm }}-realm
  namespace: keycloak
spec:
  keycloakCRName: keycloak
  realm:
    realm: {{ configuration.keycloak.realm }}
    enabled: true
    displayName: OpenShift Platform
    sslRequired: external
    registrationAllowed: false
    loginWithEmailAllowed: true
    duplicateEmailsAllowed: false
    resetPasswordAllowed: true
    editUsernameAllowed: false
    bruteForceProtected: true
    clients:
      # This cluster -- OAuth CR and client secret are configured by the playbook
      - clientId: {{ configuration.keycloak.client_id }}
        name: {{ configuration.keycloak.client_id }}
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_cluster_client_secret }}
        redirectUris:
          - "https://oauth-openshift.apps.{{ cluster.name }}.{{ cluster.base_domain }}/oauth2callback/keycloak"
        webOrigins:
          - "https://console-openshift-console.apps.{{ cluster.name }}.{{ cluster.base_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
{% for hub in configuration.keycloak.additional_hub_clusters | default([]) %}
{% set hub_domain = hub.base_domain | default(cluster.base_domain) %}
      # Other hub -- client only; that cluster wires up its own OAuth CR
      - clientId: {{ hub.name }}
        name: {{ hub.display_name | default(hub.name) }}
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_hub_client_secrets[hub.name] }}
        redirectUris:
          - "https://oauth-openshift.apps.{{ hub.name }}.{{ hub_domain }}/oauth2callback/keycloak"
        webOrigins:
          - "https://console-openshift-console.apps.{{ hub.name }}.{{ hub_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
{% endfor %}
      - clientId: gitlab
        name: GitLab
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_gitlab_client_secret }}
        redirectUris:
          - "https://gitlab.apps.{{ cluster.name }}.{{ cluster.base_domain }}/users/auth/openid_connect/callback"
        webOrigins:
          - "https://gitlab.apps.{{ cluster.name }}.{{ cluster.base_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
      - clientId: netbox
        name: NetBox
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_netbox_client_secret }}
        redirectUris:
          - "https://netbox.apps.{{ cluster.name }}.{{ cluster.base_domain }}/oauth/complete/keycloak/"
        webOrigins:
          - "https://netbox.apps.{{ cluster.name }}.{{ cluster.base_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
      - clientId: aap
        name: Ansible Automation Platform
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_aap_client_secret }}
        redirectUris:
          - "https://aap.apps.{{ cluster.name }}.{{ cluster.base_domain }}/social/complete/oidc/"
        webOrigins:
          - "https://aap.apps.{{ cluster.name }}.{{ cluster.base_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
      - clientId: vault
        name: Vault
        enabled: true
        clientAuthenticatorType: client-secret
        secret: {{ keycloak_aap_client_secret }}
        redirectUris:
          - "https://vault.apps.{{ cluster.name }}.{{ cluster.base_domain }}/social/complete/oidc/"
        webOrigins:
          - "https://vault.apps.{{ cluster.name }}.{{ cluster.base_domain }}"
        standardFlowEnabled: true
        directAccessGrantsEnabled: false
        publicClient: false
        protocol: openid-connect
        defaultClientScopes:
          - openid
          - profile
          - email
