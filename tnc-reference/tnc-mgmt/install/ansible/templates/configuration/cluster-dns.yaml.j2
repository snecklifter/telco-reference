---
apiVersion: v1
kind: Namespace
metadata:
  name: dns
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dns-named-conf
  namespace: dns
data:
  hbird-defaults.conf: |
    options {
        directory "/tmp";
        pid-file none;
        session-keyfile none;

        listen-on port 8053 { any; };
        listen-on-v6 port 8053 { none; };

        recursion yes;
        allow-recursion { any; };
        dnssec-validation no;
        minimal-any yes;
        max-cache-size 128m;

        forwarders {
{% for fwd in networking.dns_forwarders | default(['8.8.8.8', '8.8.4.4']) %}
            {{ fwd }};
{% endfor %}
        };
        forward only;
    };

    controls { };

{% for zone in dns_zones %}
    zone "{{ zone }}" IN {
        type primary;
        file "/var/named/zones/{{ zone }}.zone";
    };
{% endfor %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dns-zones
  namespace: dns
data:
{% for zone in dns_zones %}
  {{ zone }}.zone: |
    $TTL 86400
    @   IN  SOA ns1.{{ zone }}. admin.{{ zone }}. (
                2025010101  ; serial
                3600        ; refresh
                1800        ; retry
                604800      ; expire
                86400       ; minimum TTL
            )
    @       IN  NS  ns1
    ns1     IN  A   {{ networking.dns_vip }}
{% if zone == cluster.name + '.' + cluster.base_domain %}
    api     IN  A   {{ networking.api_vip }}
    api-int IN  A   {{ networking.api_vip }}
    *.apps  IN  A   {{ networking.ingress_vip }}
{% for host in hosts %}
    {{ host.hostname }}    IN  A   {{ host.ip }}
{% endfor %}
{% endif %}
{% endfor %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dns-server
  namespace: dns
spec:
  replicas: 3
  selector:
    matchLabels:
      app: dns-server
  template:
    metadata:
      labels:
        app: dns-server
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchExpressions:
                    - key: app
                      operator: In
                      values:
                        - dns-server
                topologyKey: kubernetes.io/hostname
      initContainers:
        - name: copy-config
          image: registry.access.redhat.com/ubi9/ubi-minimal:latest
          command:
            - sh
            - -c
            - |
              echo "=== Init UID ===" && id
              echo "=== Config source ===" && ls -la /config-source/
              cp /config-source/hbird-defaults.conf /config/
              echo "=== Config dest ===" && ls -la /config/
              echo "=== Zones source ===" && ls -la /zones-source/
              cp /zones-source/*.zone /zones/
              echo "=== Zones dest ===" && ls -la /zones/
          volumeMounts:
            - name: config-source
              mountPath: /config-source
            - name: config
              mountPath: /config
            - name: zones-source
              mountPath: /zones-source
            - name: zones
              mountPath: /zones
      containers:
        - name: bind
          image: registry.access.redhat.com/hi/bind:latest
          ports:
            - name: dns-udp
              containerPort: 8053
              protocol: UDP
            - name: dns-tcp
              containerPort: 8053
              protocol: TCP
          volumeMounts:
            - name: config
              mountPath: /etc/named
            - name: zones
              mountPath: /var/named/zones
          readinessProbe:
            exec:
              command:
                - dig
                - +short
                - "@127.0.0.1"
                - -p
                - "8053"
                - version.bind
                - txt
                - chaos
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            exec:
              command:
                - dig
                - +short
                - "@127.0.0.1"
                - -p
                - "8053"
                - version.bind
                - txt
                - chaos
            initialDelaySeconds: 10
            periodSeconds: 30
          resources:
            limits:
              cpu: "250m"
              memory: "256Mi"
            requests:
              cpu: "100m"
              memory: "128Mi"
      volumes:
        - name: config-source
          configMap:
            name: dns-named-conf
            defaultMode: 0444
        - name: zones-source
          configMap:
            name: dns-zones
            defaultMode: 0444
        - name: config
          emptyDir: {}
        - name: zones
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: dns-udp
  namespace: dns
  annotations:
    metallb.io/allow-shared-ip: dns
    metallb.io/loadBalancerIPs: {{ networking.dns_vip }}
spec:
  type: LoadBalancer
  selector:
    app: dns-server
  ports:
    - name: dns-udp
      port: 53
      targetPort: 8053
      protocol: UDP
---
apiVersion: v1
kind: Service
metadata:
  name: dns-tcp
  namespace: dns
  annotations:
    metallb.io/allow-shared-ip: dns
    metallb.io/loadBalancerIPs: {{ networking.dns_vip }}
spec:
  type: LoadBalancer
  selector:
    app: dns-server
  ports:
    - name: dns-tcp
      port: 53
      targetPort: 8053
      protocol: TCP
