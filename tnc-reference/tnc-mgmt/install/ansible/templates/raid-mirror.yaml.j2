---
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  name: 98-{{ role }}-raid1-mirror
  labels:
    machineconfiguration.openshift.io/role: {{ role }}
spec:
  config:
    ignition:
      version: 3.4.0
    storage:
      disks:
        - device: {{ storage.os_disks[1] }}
          wipeTable: true
          partitions:
            - label: esp-mirror
              sizeMiB: 200
              typeGuid: C12A7328-F81F-11D2-BA4B-00A0C93EC93B
            - label: boot-mirror
              sizeMiB: 1024
            - label: root-mirror
      raid:
        - name: md-boot
          level: raid1
          devices:
            - /dev/disk/by-partlabel/boot
            - /dev/disk/by-partlabel/boot-mirror
          options:
            - "--metadata=1.0"
        - name: md-root
          level: raid1
          devices:
            - /dev/disk/by-partlabel/root
            - /dev/disk/by-partlabel/root-mirror
          options:
            - "--metadata=1.0"
      filesystems:
        - device: /dev/disk/by-partlabel/esp-mirror
          format: vfat
          label: EFI-MIRROR
